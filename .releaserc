{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node -e \"const fs = require('fs'); const m = JSON.parse(fs.readFileSync('module.json', 'utf8')); m.version = '${nextRelease.version}'; fs.writeFileSync('module.json', JSON.stringify(m, null, 2) + '\\n');\" && zip -r voiced-rolls.zip module.json languages/ scripts/ README.md LICENSE"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "module.json", "label": "module.json" },
          { "path": "voiced-rolls.zip", "label": "voiced-rolls.zip" }
        ]
      }
    ]
  ]
}

{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node -e \"const fs = require('fs'); const m = JSON.parse(fs.readFileSync('module.json', 'utf8')); m.version = '${nextRelease.version}'; fs.writeFileSync('module.json', JSON.stringify(m, null, 2) + '\\n');\""
      }
    ],
    "@semantic-release/github"
  ]
}
